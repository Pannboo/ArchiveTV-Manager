# ArchiveTV Manager configuration. Copy to .env and edit:
#
#   cp .env.example .env
#
# docker compose reads this file twice: to fill in ${...} in docker-compose.yml
# and as the container's environment. Commented lines show the default.
# Any ATV_* setting can also be read from a file via <NAME>_FILE.

# --- Docker / compose ---------------------------------------------------------

# Docker network Dispatcharr is on:
#   docker inspect dispatcharr --format '{{json .NetworkSettings.Networks}}'
DISPATCHARR_NETWORK=dispatcharr_default

# Host port for the admin UI and feeds (bound to 127.0.0.1 in docker-compose.yml).
# ATV_HOST_PORT=8090
# Host folder mounted read-only at /media (idents, filler, rights-cleared files).
# ATV_MEDIA_PATH=./media
# ATV_CPUS=2.0
# ATV_MEM_LIMIT=2g
# Host file holding the YouTube Data API key (leave the file empty if unused).
# YOUTUBE_API_KEY_PATH=./secrets/youtube_api_key

# --- Admin & security -----------------------------------------------------------

# ATV_ADMIN_USERNAME=admin
# Leave empty to generate one on first start (stored in /data/run/admin_password).
ATV_ADMIN_PASSWORD=
# Session signing key. Leave empty to generate and persist one in /data/run/secret_key.
# ATV_SECRET_KEY=

# Credentials Dispatcharr uses for the Xtream Codes account.
# Leave the password empty to generate one (stored in /data/run/xc_password).
# ATV_XC_USERNAME=archivetv
ATV_XC_PASSWORD=

# Base URL Dispatcharr uses to reach this service. Change it if Dispatcharr
# is on another host, and set ATV_FEED_TOKEN as well.
# ATV_PUBLIC_BASE_URL=http://archivetv:8090
# Optional shared token required as ?token=... on the M3U/XMLTV/live feeds.
# ATV_FEED_TOKEN=
# Optional bearer token for the /api/v1 REST API.
# ATV_API_TOKEN=

# --- Schedule & catch-up --------------------------------------------------------

# ATV_DISPLAY_TZ=Europe/London
# ATV_SCHEDULE_DAYS=7
# ATV_CATCHUP_DAYS=7
# ATV_MAX_CATCHUP_SESSIONS=3

# --- Streaming / FFmpeg ---------------------------------------------------------

# ATV_MAX_STREAMS=4
# ATV_STREAM_IDLE_SECONDS=30
# ATV_FFMPEG_THREADS=2
# ATV_TRANSCODE_PRESET=veryfast
# ATV_TRANSCODE_HEIGHT=720
# ATV_TRANSCODE_VBITRATE=2500k
# Seconds of each channel prepared ahead of playback and held in RAM (max 64 MiB
# per channel), so slow or stalling origins don't reach viewers. 0 = off.
# ATV_READAHEAD_SECONDS=20
# Validation measures each remote source's download speed for this long (0 = skip)
# and flags it "slow" when below bitrate x ATV_MIN_SPEED_RATIO.
# ATV_SPEED_CHECK_SECONDS=6
# ATV_MIN_SPEED_RATIO=1.5
# Remote files are fetched over this many parallel range requests, held briefly
# in RAM (archive.org limits speed per connection). 1 = read directly.
# ATV_PARALLEL_CONNECTIONS=4

# --- Disk cache (only with minimal-disk mode off) -------------------------------

# true (the default) writes nothing to disk. Set false to allow the cache below.
# ATV_DISABLE_MEDIA_RECORDING=true
# Fallback for sources too slow even with parallel connections: on watched
# channels, download "slow source" files before they air and delete them
# afterwards. Downloads start this many hours ahead (or earlier when the
# measured speed requires it).
# ATV_CACHE_SLOW_SOURCES=false
# ATV_CACHE_LEAD_HOURS=3
# Also cache the next programmes of watched channels, whatever their speed.
# ATV_CACHE_ENABLED=false
# ATV_CACHE_MAX_GB=20

# Extra hosts that direct media URLs may point at (comma-separated, suffix match).
# ATV_ALLOWED_MEDIA_HOSTS=
# Allow media URLs on private/LAN addresses, e.g. a NAS.
# ATV_ALLOW_PRIVATE_MEDIA_HOSTS=false

# --- YouTube --------------------------------------------------------------------

# Under docker compose the API key comes from the secret file above
# (YOUTUBE_API_KEY_FILE), so YOUTUBE_API_KEY here is only for running locally.
# YOUTUBE_API_KEY=
# YOUTUBE_DAILY_QUOTA=10000
# YOUTUBE_QUOTA_RESERVE=500
# YOUTUBE_REFRESH_DAYS=30

# Unofficial discovery via YouTube's private API, used only with no API key.
# May conflict with YouTube's Terms of Service. See the README.
# ATV_YOUTUBE_UNOFFICIAL=false
# ATV_YOUTUBE_UNOFFICIAL_INTERVAL=2
# Air approved YouTube items via yt-dlp at play time (on by default). See the README.
# ATV_YOUTUBE_STREAMING=true
# ATV_YOUTUBE_STREAM_MAX_HEIGHT=1080

# --- Channel packs, break cards, HLS and the public guide --------------------

# AI helpers: none | local (OpenAI-compatible server on your network, e.g.
# Ollama) | anthropic (Claude, needs ANTHROPIC_API_KEY). See the README.
# ATV_AI_BACKEND=local
# ATV_AI_BASE_URL=http://ai-box:11434/v1
# ATV_AI_MODEL=qwen2.5:7b-instruct
# ATV_AI_API_KEY=
# ATV_AI_ENRICH=true
# YouTube keyword searches per day shared by all packs (100 quota units each).
# ATV_YOUTUBE_SEARCH_BUDGET=30
# Lab mode: channel packs set to auto-air put every playable find on air,
# Archive or YouTube, without checking licences. Private lab networks only.
# ATV_PACKS_AIR_EVERYTHING=false
# Optional theme check for channel packs (Claude reads each find's title and
# description before it airs). Secret: environment or *_FILE only.
# ANTHROPIC_API_KEY=
# ATV_THEME_CHECK_MODEL=claude-opus-5-5
# Creative Commons / public-domain music for break cards (sidecar <track>.txt = credit).
# ATV_MUSIC_DIR=./media/music
# Break-card and logo font: fontconfig name or .ttf/.otf path.
# ATV_CARD_FONT=DejaVu Sans Condensed:bold
# ATV_HLS_SEGMENT_SECONDS=4
# ATV_HLS_WINDOW=6
# Public read-only guide API at /api/public (follows ATV_FEED_TOKEN).
# ATV_PUBLIC_GUIDE=true

# --- Monitoring & maintenance ---------------------------------------------------

# Webhook that receives alerts when they first appear.
# ATV_NOTIFY_WEBHOOK=
# ATV_DB_MAX_MB=512
# ATV_TMP_WARN_PERCENT=80
# ATV_MEM_WARN_PERCENT=85
# ATV_HISTORY_KEEP_DAYS=90
# ATV_BACKUP_KEEP=7
# ATV_JOBS_ENABLED=true
# ATV_LOG_LEVEL=INFO
# ATV_LOG_FORMAT=json
