# ArchiveTV Manager configuration. Copy to .env and edit:
#
#   cp .env.example .env
#
# docker compose reads this file twice: to fill in ${...} in docker-compose.yml
# and as the container's environment. Commented lines show the default.
# Any ATV_* setting can also be read from a file via <NAME>_FILE.

# --- Docker / compose ---------------------------------------------------------

# Docker network Dispatcharr is on:
#   docker inspect dispatcharr --format '{{json .NetworkSettings.Networks}}'
DISPATCHARR_NETWORK=dispatcharr_default

# Host port for the admin UI and feeds (bound to 127.0.0.1 in docker-compose.yml).
# ATV_HOST_PORT=8090
# Host folder mounted read-only at /media (idents, filler, rights-cleared files).
# ATV_MEDIA_PATH=./media
# ATV_CPUS=2.0
# ATV_MEM_LIMIT=2g
# Host file holding the YouTube Data API key (leave the file empty if unused).
# YOUTUBE_API_KEY_PATH=./secrets/youtube_api_key

# --- Admin & security -----------------------------------------------------------

# ATV_ADMIN_USERNAME=admin
# Leave empty to generate one on first start (stored in /data/run/admin_password).
ATV_ADMIN_PASSWORD=
# Session signing key. Leave empty to generate and persist one in /data/run/secret_key.
# ATV_SECRET_KEY=

# Credentials Dispatcharr uses for the Xtream Codes account.
# Leave the password empty to generate one (stored in /data/run/xc_password).
# ATV_XC_USERNAME=archivetv
ATV_XC_PASSWORD=

# Base URL Dispatcharr uses to reach this service. Change it if Dispatcharr
# is on another host, and set ATV_FEED_TOKEN as well.
# ATV_PUBLIC_BASE_URL=http://archivetv:8090
# Optional shared token required as ?token=... on the M3U/XMLTV/live feeds.
# ATV_FEED_TOKEN=
# Optional bearer token for the /api/v1 REST API.
# ATV_API_TOKEN=

# --- Schedule & catch-up --------------------------------------------------------

# ATV_DISPLAY_TZ=Europe/London
# ATV_SCHEDULE_DAYS=7
# ATV_CATCHUP_DAYS=7
# ATV_MAX_CATCHUP_SESSIONS=3

# --- Streaming / FFmpeg ---------------------------------------------------------

# ATV_MAX_STREAMS=4
# ATV_STREAM_IDLE_SECONDS=30
# ATV_FFMPEG_THREADS=2
# ATV_TRANSCODE_PRESET=veryfast
# ATV_TRANSCODE_HEIGHT=720
# ATV_TRANSCODE_VBITRATE=2500k

# Extra hosts that direct media URLs may point at (comma-separated, suffix match).
# ATV_ALLOWED_MEDIA_HOSTS=
# Allow media URLs on private/LAN addresses, e.g. a NAS.
# ATV_ALLOW_PRIVATE_MEDIA_HOSTS=false

# --- YouTube --------------------------------------------------------------------

# Under docker compose the API key comes from the secret file above
# (YOUTUBE_API_KEY_FILE), so YOUTUBE_API_KEY here is only for running locally.
# YOUTUBE_API_KEY=
# YOUTUBE_DAILY_QUOTA=10000
# YOUTUBE_QUOTA_RESERVE=500
# YOUTUBE_REFRESH_DAYS=30

# Unofficial discovery via YouTube's private API, used only with no API key.
# May conflict with YouTube's Terms of Service. See the README.
# ATV_YOUTUBE_UNOFFICIAL=false
# ATV_YOUTUBE_UNOFFICIAL_INTERVAL=2
# Experimental: air approved YouTube items via yt-dlp at play time. See the README.
# ATV_YOUTUBE_STREAMING=false
# ATV_YOUTUBE_STREAM_MAX_HEIGHT=1080

# --- Monitoring & maintenance ---------------------------------------------------

# Webhook that receives alerts when they first appear.
# ATV_NOTIFY_WEBHOOK=
# ATV_DB_MAX_MB=512
# ATV_TMP_WARN_PERCENT=80
# ATV_MEM_WARN_PERCENT=85
# ATV_HISTORY_KEEP_DAYS=90
# ATV_BACKUP_KEEP=7
# ATV_JOBS_ENABLED=true
# ATV_LOG_LEVEL=INFO
# ATV_LOG_FORMAT=json
